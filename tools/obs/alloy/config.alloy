// Alloy config for the misplease prod VM.
//
// Four jobs, nothing else:
//   1. host metrics        (node_exporter collectors, in-process)
//   2. container metrics   (cAdvisor, in-process; no separate container)
//   3. container logs      (docker API -> VictoriaLogs, live)
//   4. OTLP receiver       (traces -> VictoriaTraces; the login trace work)
//
// Logs are tailed from the docker API and pushed to VictoriaLogs as they are
// written. Docker's own json-file is only the transport buffer: it is rotated in
// compose (50 MB x 2), so disk stays bounded, and a container that is deleted or
// recreated does not take its logs with it. Alloy keeps a positions file in
// /var/lib/alloy/data, so an Alloy restart resumes instead of losing the gap.
// tools/obs/import-logs.py remains for backfilling logs from before this was on.
//
// Editing this file on the VM is not the source of truth: it is mounted from the
// repo checkout at ./tools/obs/alloy/config.alloy.

logging {
  level  = "warn"
  format = "logfmt"
}

// --- host metrics ------------------------------------------------------------

prometheus.exporter.unix "host" {
  rootfs_path = "/host/root"
  procfs_path = "/host/proc"
  sysfs_path  = "/host/sys"
}

discovery.relabel "host" {
  targets = prometheus.exporter.unix.host.targets

  rule {
    target_label = "instance"
    replacement  = "misplease-prod-vm"
  }

  rule {
    target_label = "job"
    replacement  = "node"
  }
}

prometheus.scrape "host" {
  targets         = discovery.relabel.host.output
  forward_to      = [prometheus.remote_write.metrics.receiver]
  scrape_interval = "30s"
  scrape_timeout  = "10s"
}

// --- container metrics -------------------------------------------------------

prometheus.exporter.cadvisor "containers" {
  docker_host               = "unix:///var/run/docker.sock"
  docker_only               = true
  disable_root_cgroup_stats = true
  // Trim series we never query here: the question is RAM/CPU per container.
  disabled_metrics = [
    "advtcp", "app", "cpu_topology", "cpuset", "disk", "diskIO", "hugetlb",
    "memory_numa", "network", "perf_event", "process", "referenced_memory",
    "resctrl", "sched", "tcp", "udp",
  ]
  // Keep only the compose labels; the rest is series bloat.
  store_container_labels        = false
  allowlisted_container_labels  = ["com.docker.compose.service", "com.docker.compose.project"]
  housekeeping_interval    = "30s"
  max_housekeeping_interval = "60s"
  storage_duration         = "30s"
}

discovery.relabel "containers" {
  targets = prometheus.exporter.cadvisor.containers.targets

  rule {
    target_label = "job"
    replacement  = "cadvisor"
  }
}

prometheus.scrape "containers" {
  targets         = discovery.relabel.containers.output
  forward_to      = [prometheus.remote_write.metrics.receiver]
  scrape_interval = "30s"
  scrape_timeout  = "10s"
}

// --- storage -----------------------------------------------------------------

prometheus.remote_write "metrics" {
  endpoint {
    url = "http://victoriametrics:8428/api/v1/write"
  }
}

// --- container logs ----------------------------------------------------------
// Recommended path for docker logs with Alloy: discover containers through the
// docker API and tail their stdout/stderr, rather than reading json files from
// /var/lib/docker or switching the daemon to journald.

discovery.docker "containers" {
  host = "unix:///var/run/docker.sock"
}

discovery.relabel "logs" {
  targets = discovery.docker.containers.targets

  // Container name without the leading slash ("/misplease-main" -> "misplease-main").
  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "^/(.*)$"
    target_label  = "container"
  }

  rule {
    source_labels = ["__meta_docker_container_log_stream"]
    target_label  = "stream"
  }

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    target_label  = "service"
  }

  rule {
    source_labels = ["__meta_docker_container_image"]
    target_label  = "image"
  }
}

loki.source.docker "containers" {
  host       = "unix:///var/run/docker.sock"
  targets    = discovery.relabel.logs.output
  labels     = {}
  forward_to = [loki.write.logs.receiver]
}

// VictoriaLogs speaks the Loki push protocol on /insert/loki/api/v1/push; its
// own 7d retention (docker-compose.obs.yml) is what bounds history.
//
// _msg_field=msg is a VictoriaLogs extension: when a line is JSON it unpacks it
// into fields, and without this the message would be replaced by a "missing
// _msg field" placeholder (auth and alloy log JSON). With it, `msg` becomes the
// searchable message and every other field stays queryable. Plain lines (Paper,
// Velocity, Postgres) are unaffected.
loki.write "logs" {
  endpoint {
    url = "http://victoria-logs:9428/insert/loki/api/v1/push?_msg_field=msg"
  }

  external_labels = {
    host = "misplease-prod-vm",
  }
}

// --- OTLP traces -------------------------------------------------------------
// Senders: alloy:4318 (HTTP) or alloy:4317 (gRPC) on the misplease network.

otelcol.receiver.otlp "default" {
  grpc {
    endpoint = "0.0.0.0:4317"
  }

  http {
    endpoint = "0.0.0.0:4318"
  }

  output {
    traces = [otelcol.processor.batch.default.input]
  }
}

otelcol.processor.batch "default" {
  timeout = "2s"

  output {
    traces = [otelcol.exporter.otlphttp.traces.input]
  }
}

otelcol.exporter.otlphttp "traces" {
  client {
    // otlphttp appends /v1/traces, so this lands on
    // http://victoria-traces:10428/insert/opentelemetry/v1/traces
    endpoint = "http://victoria-traces:10428/insert/opentelemetry"
    timeout  = "10s"
  }

  sending_queue {
    enabled    = true
    queue_size = 512
  }
}
