DB_PASSWORD=change-me
REDIS_PASSWORD=change-me
# RCON stays unpublished. Prefer a random value (openssl rand -hex 24).
# Injected into backends for RCON. Never paste into chat.
RCON_PASSWORD=
# GHCR tag from images.yml (`dev` on main, or a full commit sha).
IMAGE_TAG=dev
# Optional heap overrides (preprod with less RAM):
# MAIN_JVM_OPTS=-Xms512M -Xmx2G -XX:+UseG1GC -Dpaper.preferSparkPlugin=true
# TECH_JVM_OPTS=-Xms256M -Xmx1536M -XX:+UseG1GC -Dpaper.preferSparkPlugin=true
# VELOCITY_JVM_OPTS=-Xms128M -Xmx256M
PLUGIN_GITHUB_TOKEN=
