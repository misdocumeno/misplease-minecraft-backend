DB_PASSWORD=change-me
REDIS_PASSWORD=change-me
# Host-only admin API on auth (:3000 /admin/*). openssl rand -hex 32
# CLI: tools/auth-admin/misplease-auth (reads this from stack .env)
AUTH_ADMIN_TOKEN=
# RCON stays unpublished on the host (compose does not map 25575).
# Only reachable on the Docker network (deployer → main/tech:25575).
# Prefer a random value (openssl rand -hex 24). Never paste into chat.
# Required for config hot-reload (tools/deploy/hot-reload.yml).
RCON_PASSWORD=
# Shared Velocity modern-forwarding secret (openssl rand -hex 16). Same value on
# proxy forwarding.secret and Paper proxies.velocity.secret via entrypoint.
VELOCITY_FORWARDING_SECRET=
# GHCR tag from images.yml (`dev` on main, or a full commit sha).
# The ops deployer agent pins IMAGE_TAG in this file after a healthy apply.
# Leaving `dev` is fine until the first successful CD apply.
IMAGE_TAG=dev
# Optional deployer tuning / alert (ops profile service `deployer`):
# DEPLOY_POLL_SECONDS=15
# DEPLOY_EMPTY_SECONDS=60
# DEPLOY_HEALTH_TIMEOUT_S=180
# DEPLOY_ALERT_WEBHOOK=
# JVM_OPTS sources (same flags everywhere; only heaps change):
# - entrypoint: java ${JVM_OPTS} -jar …
# - smoke: hard-coded in docker/smoke-check.sh (small heap)
# - local compose: docker-compose.yml
# - preprod/prod images: docker-compose.prod.yml, overridable here
#
# Live prod main today (itzg): -Xms256M -Xmx3G + G1 + ParallelRefProc + MaxGCPause 200
# + DisableExplicitGC + QuickShop SIGNATURE_VERIFY skip + jdk.incubator.vector
# Live prod tech today: -Xms256M -Xmx2G -XX:+UseG1GC -XX:MaxGCPauseMillis=200
# New stack also sets -Dpaper.preferSparkPlugin=true (baked spark jar).
#
# Preprod (smaller host) — keep full flag set, only shrink heaps:
# MAIN_JVM_OPTS=-Xms512M -Xmx2G -XX:+UseG1GC -XX:+ParallelRefProcEnabled -XX:MaxGCPauseMillis=200 -XX:+DisableExplicitGC -Dorg.maxgamer.quickshop.util.envcheck.skip.SIGNATURE_VERIFY -Dpaper.preferSparkPlugin=true --add-modules=jdk.incubator.vector
# TECH_JVM_OPTS=-Xms256M -Xmx1536M -XX:+UseG1GC -XX:MaxGCPauseMillis=200 -Dpaper.preferSparkPlugin=true
# VELOCITY_JVM_OPTS=-Xms128M -Xmx256M
PLUGIN_GITHUB_TOKEN=
# Self-hosted Actions runner (ops profile). Registration token from
# Repo → Settings → Actions → Runners → New self-hosted runner (~1h life).
# Keep until CD is proven. Persistence needs CONFIGURED_ACTIONS_RUNNER_FILES_DIR
# + DISABLE_AUTOMATIC_DEREGISTRATION on the github-runner service (see compose).
GH_RUNNER_REGISTRATION_TOKEN=
# Optional name override (preprod: misplease-preprod).
GH_RUNNER_NAME=misplease
# Optional long-lived fine-grained PAT (Administration) instead of one-shot token.
# GH_RUNNER_PAT=
# GHCR: do not put the token here — on the host run:
#   echo TOKEN | docker login ghcr.io -u USER --password-stdin
# (classic PAT with read:packages). Compose runner mounts ~/.docker/config.json.
#
# restic → Windows rest-server (lan-bridge IP of the Windows host, port 8000).
# Preprod uses a separate repo name so it never shares prod snapshots.
# RESTIC_REPOSITORY=rest:http://192.168.100.30:8000/misplease-preprod/
# RESTIC_PASSWORD=
# BACKUP_AT_HOUR=6
# BACKUP_AT_MINUTE=0
