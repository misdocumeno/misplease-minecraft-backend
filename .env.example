DB_PASSWORD=change-me
REDIS_PASSWORD=change-me
# RCON stays unpublished. Prefer a random value (openssl rand -hex 24).
# Injected into backends for RCON. Never paste into chat.
RCON_PASSWORD=
# GHCR tag from images.yml (`dev` on main, or a full commit sha).
IMAGE_TAG=dev
# Optional heap overrides (preprod with less RAM):
# MAIN_JVM_OPTS=-Xms512M -Xmx2G -XX:+UseG1GC -Dpaper.preferSparkPlugin=true
# TECH_JVM_OPTS=-Xms256M -Xmx1536M -XX:+UseG1GC -Dpaper.preferSparkPlugin=true
# VELOCITY_JVM_OPTS=-Xms128M -Xmx256M
PLUGIN_GITHUB_TOKEN=
# Self-hosted Actions runner (ops profile). One-shot registration token from
# Repo → Settings → Actions → Runners → New self-hosted runner (~1h life).
# Remove after first successful register; credentials live in the volume.
GH_RUNNER_REGISTRATION_TOKEN=
# Optional name override (preprod: misplease-preprod).
GH_RUNNER_NAME=misplease
# Optional long-lived fine-grained PAT (Administration) instead of one-shot token.
# GH_RUNNER_PAT=
# GHCR pull (private packages). Create a classic read:packages or fine-grained
# Packages: Read for this repo's packages; docker login ghcr.io -u USER --password-stdin
# GHCR_TOKEN=

